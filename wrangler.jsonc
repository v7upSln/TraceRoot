{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "traceroot",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /sitemap.xml goes through the Worker; everything else is served straight from assets.
    "run_worker_first": ["/sitemap.xml"]
  },
  "vars": {
    "API_ORIGIN": "https://traceroot-be.onrender.com"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
